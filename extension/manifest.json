{
  "manifest_version": 3,
  "name": "Meeting Timer Overlay",
  "version": "1.2.0",
  "description": "A calm, fair turn timer for Google Slides meetings: splits the time left evenly and shows whose turn it is.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/service_worker.js"
  },
  "action": {
    "default_title": "Meeting Timer Overlay",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "next-section": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Advance to the next section"
    },
    "previous-section": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Return to the previous section"
    },
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Show or hide the overlay"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*"],
      "js": ["src/schedule.js", "src/slide_dom.js", "src/overlay.js", "src/content.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
